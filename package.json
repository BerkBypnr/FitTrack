{
  "name": "fittrack-mobile",
  "version": "0.14.4",
  "private": true,
  "description": "FitTrack Android app: vanilla web UI with standard Gradle/Capacitor source",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/test.cjs",
    "test:runtime": "node tests/review/review.cjs && node tests/hotfix-0114.cjs && node tests/auth-0116.cjs",
    "test:database": "node tests/database-0114.cjs",
    "build:android": "python3 scripts/build_android.py",
    "build:android:signed": "python3 scripts/build_android.py --sign",
    "build:web": "node scripts/stage_web.cjs",
    "sync:android": "node scripts/stage_web.cjs && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@electric-sql/pglite": "0.5.8",
    "linkedom": "0.18.13",
    "cssom": "0.5.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.1"
  }
}

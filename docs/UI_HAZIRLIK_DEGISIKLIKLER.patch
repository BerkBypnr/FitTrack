+.trainer-overview > * { min-width: 0; padding: 17px 8px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); text-align: center; }
+.trainer-overview strong, .trainer-overview span { display: block; }
+.trainer-overview strong { font-size: 26px; font-variant-numeric: tabular-nums; }
+.trainer-overview span { margin-top: 6px; color: var(--muted); font-size: 12px; line-height: 1.4; }
+.trainer-quick-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
+.trainer-quick-actions button { min-width: 0; display: flex; justify-content: center; align-items: center; gap: 8px; }
+.trainer-quick-actions svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; }
+.trainer-home .section-head { gap: 10px; flex-wrap: wrap; align-items: center; }
+.trainer-home .section-head h2 { margin: 0; font-size: 21px; line-height: 1.3; }
+.trainer-home .section-head .text-btn { min-height: 44px; font-size: 12px; text-align: left; }
+.trainer-count { padding: 3px 7px; border-radius: 8px; background: var(--surface-2); color: var(--muted); font-size: 13px; vertical-align: middle; }
+.trainer-member-list.revised-members, .trainer-member-list.priority-member-list { display: grid; gap: 14px; }
+.trainer-member-card.revised-member-card { display: block; padding: 0; border: 1px solid var(--line-strong); border-radius: 19px; background: var(--surface); }
+.revised-member-card .member-card-main { min-height: 86px; padding: 16px 16px 10px; grid-template-columns: 54px minmax(0, 1fr) 20px; gap: 12px; }
+.revised-member-card .member-avatar, .trainer-recent .member-avatar { background: var(--surface-3); color: var(--text); border: 1px solid var(--line); box-shadow: none; }
+.revised-member-card .member-avatar { width: 54px; height: 54px; border-radius: 18px; }
+.revised-member-card .member-card-copy { min-width: 0; }
+.revised-member-card .member-card-copy strong { white-space: normal; overflow-wrap: anywhere; font-size: 17px; line-height: 1.3; }
+.trainer-state { display: inline-block; margin-top: 7px; padding: 4px 7px; border-radius: 7px; font-size: 11px; font-weight: 750; line-height: 1.4; }
+.trainer-state-info { color: var(--status-info); background: color-mix(in srgb, var(--status-info) 12%, var(--surface)); }
+.trainer-state-warning { color: var(--status-warning); background: color-mix(in srgb, var(--status-warning) 12%, var(--surface)); }
+.trainer-state-success { color: var(--status-success); background: color-mix(in srgb, var(--status-success) 12%, var(--surface)); }
+.trainer-state-neutral { color: var(--muted); background: var(--surface-2); }
+.trainer-member-summary { padding: 0 16px 14px; overflow-wrap: anywhere; }
+.trainer-member-summary p { margin: 0 0 6px; color: var(--text); font-size: 14px; font-weight: 650; line-height: 1.45; }
+.trainer-member-summary small { display: block; color: var(--muted); font-size: 12px; line-height: 1.55; }
+.trainer-card-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; padding: 0 16px 16px; }
+.trainer-card-actions .secondary-btn { min-width: 0; min-height: 44px; margin: 0; padding: 9px; border: 1px solid var(--line-strong); border-radius: 11px; background: var(--surface-2); color: var(--text); font-size: 13px; }
+.trainer-card-actions .member-chat-shortcut { display: flex; justify-content: center; gap: 6px; }
+.trainer-card-actions .member-chat-shortcut svg { width: 17px; }
+.trainer-card-actions .member-chat-shortcut b { margin-left: 0; background: var(--surface-3); color: var(--text); }
+.trainer-ui-revision .trainer-filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
+.trainer-ui-revision .trainer-filters button { min-width: 0; padding-inline: 5px; }
+.trainer-data-note { margin: 12px 0 16px; color: var(--muted); font-size: 12px; line-height: 1.6; }
+.trainer-home .home-message-card { background: var(--surface); border-color: var(--line); }
+.trainer-home .home-message-card h3 { font-size: 16px; }
+.trainer-home .home-message-card .coach-avatar { color: var(--text); background: var(--surface-3); }
+.trainer-recent-list { border: 1px solid var(--line); border-radius: 16px; background: var(--surface); overflow: hidden; }
+.trainer-recent-list > button { display: grid; grid-template-columns: 38px minmax(0, 1fr) 18px; gap: 10px; width: 100%; padding: 14px; text-align: left; }
+.trainer-recent-list > button + button { border-top: 1px solid var(--line); }
+.trainer-recent-list .member-avatar { width: 38px; height: 38px; font-size: 12px; }
+.trainer-recent-list strong { display: block; font-size: 14px; overflow-wrap: anywhere; }
+.trainer-recent-list small { display: block; margin-top: 5px; color: var(--muted); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
+.trainer-recent-list .small-arrow svg { width: 18px; }
+.trainer-recent-list > .trainer-data-note { padding: 0 14px; }
+@media (max-width: 360px) {
+  .trainer-card-actions { padding-inline: 12px; gap: 6px; }
+  .revised-member-card .member-card-main { padding-inline: 12px; gap: 8px; grid-template-columns: 48px minmax(0, 1fr) 18px; }
+  .revised-member-card .member-avatar { width: 48px; height: 48px; }
+  .trainer-member-summary { padding-inline: 12px; }
+}

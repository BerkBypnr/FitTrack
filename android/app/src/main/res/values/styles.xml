<?xml version='1.0' encoding='utf-8'?>
<resources>
  <style name="AppTheme" parent="@style/Theme.AppCompat.Light.DarkActionBar">
    <item name="colorAccent">@color/colorAccent</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
  </style>
  <style name="AppTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:background">@null</item>
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
  </style>
  <style name="AppTheme.NoActionBarLaunch" parent="@style/Theme.SplashScreen">
    <item name="android:background">@drawable/fittrack_splash</item>
    <item name="android:statusBarColor">#ff080b10</item>
    <item name="android:navigationBarColor">#ff080b10</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/fittrack_app_icon</item>
    <item name="windowSplashScreenBackground">#ff080b10</item>
  </style>
</resources>